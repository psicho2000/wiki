{
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.bracketPairColorization.enabled": true,
    "editor.largeFileOptimizations": false,
    "editor.fontFamily": "MonaspiceNe Nerd Font",
    "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
    "editor.formatOnSave": true,
    "editor.minimap.enabled": false,
    "editor.mouseWheelZoom": true,
    "editor.cursorBlinking": "expand",
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },
    "files.hotExit": "off",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "git.enableSmartCommit": true,
    "git.autofetch": true,
    "git.confirmSync": false,
    "isort.args": [
        "--profile",
        "black"
    ],
    "black-formatter.args": [
        "--line-length",
        "130"
    ],
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": true
        }
    },
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "pylint.args": [
        "--max-line-length=130"
    ],
    "search.exclude": {
        "tags": true,
        "tags.temp": true
    },
    "shellcheck.customArgs": [
        "-x"
    ],
    "terminal.explorerKind": "external",
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.fontFamily": "MonaspiceNe Nerd Font",
    "terminal.integrated.hideOnStartup": "always",
    "terminal.integrated.profiles.linux": {
        "zsh": {
            "path": "zsh",
            "args": [
                "--login"
            ]
        }
    },
    "window.autoDetectColorScheme": true,
    "window.autoDetectHighContrast": true,
    "window.restoreWindows": "none",
    "window.title": "${dirty}${activeEditorShort}${separator}${rootPath}",
    "window.zoomLevel": 2,
    "workbench.colorTheme": "Solarized Dark",
    "workbench.editor.enablePreview": false,
    "workbench.startupEditor": "newUntitledFile",
    "zenMode.hideLineNumbers": false,
    "editor.renderLineHighlight": "gutter",
    "workbench.colorCustomizations": {
        "contrastBorder": "#b7a47460",
        "editor.lineHighlightBackground": "#b7a47460",
        "editor.wordHighlightBackground": "#b7a47430",
        "editor.wordHighlightBorder": "#b7a47430",
        "editor.wordHighlightStrongBackground": "#b7a474b2",
        "editor.wordHighlightStrongBorder": "#b7a474b2",
        "editorUnicodeHighlight.border": "#ff0000dc",
        "editorUnicodeHighlight.background": "#ff00005b"
    },
    "editor.unicodeHighlight.includeComments": true,
    "editor.unicodeHighlight.nonBasicASCII": true,
    "editor.unicodeHighlight.allowedCharacters": {
        "ä": true,
        "ö": true,
        "ü": true,
        "Ä": true,
        "Ö": true,
        "Ü": true,
        "ß": true,
        "ℹ️": true,
        "⚠️": true,
        "✅": true,
        "💥": true,
        "❌": true
    }
}
